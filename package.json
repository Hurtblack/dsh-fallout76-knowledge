    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hurtblack/dsh-fallout76-knowledge.git"
  },
  "homepage": "https://github.com/Hurtblack/dsh-fallout76-knowledge#readme",
