{
  "name": "dsh-fallout76-knowledge",
  "version": "0.1.2",
  "type": "module",
  "description": "辐射76群聊知识库：静默学习玩家讨论、带来源检索、冲突和版本管理",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
